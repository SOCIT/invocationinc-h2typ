# Stripe (required for live checkout via /api/checkout)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs. Checkout reads STRIPE_PRICE_BOOK. One H2TYP purchase: ebook $9.99.
# Live Price (999¢): price_1UMYUhPj4KYXkIe0wIBODvIa
STRIPE_PRICE_BOOK=price_1UMYUhPj4KYXkIe0wIBODvIa
STRIPE_PRICE_STACK=price_...

# Public site URL (no trailing slash) — used for Checkout success/cancel redirects
# Local: http://localhost:3000
# Production: https://invocationinc.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Newsletter signups are stored as contacts in a Resend audience.
# /api/subscribe fails closed when either value is missing.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
